ENTORNO=PRODUCCION
ADMIN_USER=usuario
ADMIN_PASSWORD=contraseña

# Configuración para el nivel de logs (puedes cambiarlo a DEBUG, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG
LOG_TAMANO_FICHERO=5 # en MB
LOG_NUM_FICHEROS_RESPALDO=3 # 3 copias + el actual, no supera los 20MB (5MB * 4 ficheros)
LOG_FILE_PATH=logs/diario_hierro.log